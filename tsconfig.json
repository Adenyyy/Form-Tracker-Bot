{
  "compilerOptions": {
      "target": "ES2023",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "moduleDetection": "auto",
      "lib": ["ES2023"],
      "types": ["node"],
      "declaration": false,
      "sourceMap": true,
      "outDir": "./build",
      "rootDir": "src",
      "allowJs": true,
      "strict": false,
      "resolveJsonModule": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["build", "node_modules", "tests", ".vscode", ".idea"]
}
